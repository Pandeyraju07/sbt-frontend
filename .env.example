# SBT Frontend environment example
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secrets, private keys, database credentials, or refresh-token
# signing material in frontend environment files. Anything here is public.

VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=SBT
VITE_APP_ENV=development
